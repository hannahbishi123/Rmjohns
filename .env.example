# ═══════════════════════════════════════════════════════════════════════════════
# RMJohn's Eateries System — environment configuration template
#
# Copy this file to .env and fill in your actual values.
# .env is git-ignored and must NEVER be committed.
#
# ARCHITECTURE
# ────────────────────────────────────────────────────────────────────────────
# LOCAL (npm run dev on your PC):
#   Frontend  →  Express backend (this file's vars)  →  XAMPP/MySQL
#                                                    ↕  Firebase LIVE (same project)
#
# LIVE DOMAIN (https://rmjohns-eateries.web.app):
#   Frontend  →  Firebase Auth + Firebase Realtime DB (VITE_* vars baked into build)
#
# The same Firebase project is used for BOTH environments.
# XAMPP does not need to be running for the live domain to work.
# ═══════════════════════════════════════════════════════════════════════════════


# ── MySQL / XAMPP ─────────────────────────────────────────────────────────────
# Local database — primary source of truth when running on localhost.
# Import database/eateries_db.sql in phpMyAdmin before starting the server.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eateries_db

# Port the Express API listens on (Vite dev proxy forwards /api/* here)
API_PORT=3001


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the backend API.
# Leave empty to allow all origins (fine for pure local dev).
# For production: set to your Firebase Hosting domain(s).
CORS_ORIGINS=https://rmjohns-eateries.web.app,https://rmjohns-eateries.firebaseapp.com


# ── Firebase — Admin SDK (backend only, NEVER exposed to the browser) ─────────
# 1. Go to Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate new private key" → download the JSON file
# 3. Rename the file to firebase-service-account.json
# 4. Place it at:  backend/firebase-service-account.json
#    (this path is git-ignored — never commit it)
#
# FIREBASE_DATABASE_URL: found in Firebase Console → Realtime Database → Data tab (URL at top)
# FIREBASE_ENABLED: set to false to disable Firebase sync entirely (XAMPP-only mode)
FIREBASE_DATABASE_URL=https://rmjohns-eateries-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT=./backend/firebase-service-account.json
FIREBASE_ENABLED=true


# ── Firebase — Web SDK (frontend, VITE_ prefix = safe to include in builds) ───
# These are NOT secret — they are public identifiers restricted by Firebase
# Security Rules and Firebase Auth domain restrictions.
# Get these values from: Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=rmjohns-eateries.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://rmjohns-eateries-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=rmjohns-eateries
VITE_FIREBASE_STORAGE_BUCKET=rmjohns-eateries.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id


# ── API base URL (frontend → backend) ─────────────────────────────────────────
# LOCAL DEV: Leave empty — Vite's dev proxy rewrites /api/* to http://localhost:3001
#
# DEPLOYED BACKEND (e.g. Railway, Render, Fly.io):
#   Set this to the public URL of your deployed Express server so the live
#   frontend can reach MySQL data via the API.
#   Example:  VITE_API_BASE_URL=https://rmjohns-api.railway.app
#
# FIREBASE HOSTING ONLY (no deployed backend):
#   Leave empty. The frontend will fall back to Firebase directly for all reads/writes.
VITE_API_BASE_URL=
